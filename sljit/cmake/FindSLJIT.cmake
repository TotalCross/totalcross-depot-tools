get_filename_component(SLJIT_DEPENDENCY_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(SLJIT_LOCAL_ROOT "${SLJIT_DEPENDENCY_DIR}/local")

if(APPLE AND (CMAKE_SYSTEM_NAME STREQUAL "iOS" OR CMAKE_OSX_SYSROOT MATCHES "[Ii]phone"))
  message(FATAL_ERROR "SLJIT prebuilt artifacts do not support iOS")
elseif(DEFINED ANDROID_ABI)
  set(SLJIT_PLATFORM android)
  set(SLJIT_ARCH "${ANDROID_ABI}")
elseif(WIN32)
  set(SLJIT_PLATFORM windows)
  set(SLJIT_WINDOWS_PLATFORM "${CMAKE_VS_PLATFORM_NAME}")
  if(NOT SLJIT_WINDOWS_PLATFORM)
    set(SLJIT_WINDOWS_PLATFORM "${CMAKE_GENERATOR_PLATFORM}")
  endif()
  string(TOLOWER "${SLJIT_WINDOWS_PLATFORM}" SLJIT_WINDOWS_PLATFORM)
  if(SLJIT_WINDOWS_PLATFORM STREQUAL "win32")
    set(SLJIT_ARCH x86)
  elseif(SLJIT_WINDOWS_PLATFORM STREQUAL "arm64")
    set(SLJIT_ARCH arm64)
  elseif(SLJIT_WINDOWS_PLATFORM STREQUAL "x64" OR CMAKE_SIZEOF_VOID_P EQUAL 8)
    set(SLJIT_ARCH x64)
  else()
    message(FATAL_ERROR "Unsupported SLJIT Windows architecture: ${SLJIT_WINDOWS_PLATFORM}")
  endif()
elseif(APPLE)
  set(SLJIT_PLATFORM macos)
  set(SLJIT_ARCH "${CMAKE_OSX_ARCHITECTURES}")
elseif(UNIX AND CMAKE_SYSTEM_NAME STREQUAL "Linux")
  set(SLJIT_PLATFORM linux)
  set(SLJIT_ARCH "${CMAKE_SYSTEM_PROCESSOR}")
else()
  message(FATAL_ERROR "Unsupported SLJIT target ${CMAKE_SYSTEM_NAME}/${CMAKE_SYSTEM_PROCESSOR}")
endif()
if(NOT SLJIT_ARCH)
  set(SLJIT_ARCH "${CMAKE_SYSTEM_PROCESSOR}")
endif()
list(GET SLJIT_ARCH 0 SLJIT_ARCH)
string(TOLOWER "${SLJIT_ARCH}" SLJIT_ARCH)
if(SLJIT_ARCH STREQUAL "amd64" OR SLJIT_ARCH STREQUAL "x86_64")
  if(SLJIT_PLATFORM STREQUAL linux)
    set(SLJIT_ARCH x86_64)
  elseif(SLJIT_PLATFORM STREQUAL windows)
    set(SLJIT_ARCH x64)
  endif()
elseif(SLJIT_ARCH STREQUAL "aarch64")
  if(SLJIT_PLATFORM STREQUAL linux)
    set(SLJIT_ARCH aarch64)
  else()
    set(SLJIT_ARCH arm64)
  endif()
elseif(SLJIT_ARCH STREQUAL "arm64" AND SLJIT_PLATFORM STREQUAL linux)
  set(SLJIT_ARCH aarch64)
elseif(SLJIT_ARCH STREQUAL "arm" OR SLJIT_ARCH STREQUAL "armv7")
  set(SLJIT_ARCH armv7l)
endif()

if(NOT "${SLJIT_PLATFORM}/${SLJIT_ARCH}" MATCHES "^(linux/(x86_64|armv7l|aarch64)|windows/(x86|x64|arm64)|android/arm64-v8a|macos/arm64)$")
  message(FATAL_ERROR "Unsupported SLJIT platform/architecture: ${SLJIT_PLATFORM}/${SLJIT_ARCH}")
endif()
set(SLJIT_DIR "${SLJIT_LOCAL_ROOT}/${SLJIT_PLATFORM}/${SLJIT_ARCH}" CACHE PATH "SLJIT prebuilt directory" FORCE)
set(SLJIT_MANIFEST "${SLJIT_DIR}/manifest.txt")
find_path(SLJIT_INCLUDE_DIR NAMES sljitLir.h HINTS "${SLJIT_DIR}/include" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
find_library(SLJIT_LIBRARY NAMES sljit libsljit HINTS "${SLJIT_DIR}/lib" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(SLJIT REQUIRED_VARS SLJIT_INCLUDE_DIR SLJIT_LIBRARY SLJIT_MANIFEST)
if(SLJIT_FOUND AND NOT TARGET SLJIT::SLJIT)
  add_library(SLJIT::SLJIT STATIC IMPORTED)
  set_target_properties(SLJIT::SLJIT PROPERTIES
    IMPORTED_LOCATION "${SLJIT_LIBRARY}"
    INTERFACE_INCLUDE_DIRECTORIES "${SLJIT_INCLUDE_DIR}"
    INTERFACE_COMPILE_DEFINITIONS "SLJIT_WX_EXECUTABLE_ALLOCATOR=1;SLJIT_PROT_EXECUTABLE_ALLOCATOR=0;SLJIT_ARGUMENT_CHECKS=1;SLJIT_DEBUG=0;SLJIT_VERBOSE=0")
  if(NOT WIN32)
    find_package(Threads REQUIRED)
    set_property(TARGET SLJIT::SLJIT APPEND PROPERTY INTERFACE_LINK_LIBRARIES Threads::Threads)
  endif()
endif()
