get_filename_component(AxTLS_DEPENDENCY_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(AxTLS_LOCAL_ROOT "${AxTLS_DEPENDENCY_DIR}/local")

if(DEFINED ANDROID_ABI)
  set(AxTLS_PLATFORM android)
  set(AxTLS_ARCH "${ANDROID_ABI}")
elseif(APPLE AND (CMAKE_SYSTEM_NAME STREQUAL "iOS" OR CMAKE_OSX_SYSROOT MATCHES "[Ii]phone"))
  if(CMAKE_OSX_SYSROOT MATCHES "[Ii]phone[Ss]imulator")
    set(AxTLS_PLATFORM ios-simulator)
  else()
    set(AxTLS_PLATFORM ios)
  endif()
  set(AxTLS_ARCH "${CMAKE_OSX_ARCHITECTURES}")
  if(NOT AxTLS_ARCH)
    set(AxTLS_ARCH arm64)
  endif()
  list(GET AxTLS_ARCH 0 AxTLS_ARCH)
elseif(WIN32)
  set(AxTLS_PLATFORM windows)
  set(AxTLS_WINDOWS_PLATFORM "${CMAKE_VS_PLATFORM_NAME}")
  if(NOT AxTLS_WINDOWS_PLATFORM)
    set(AxTLS_WINDOWS_PLATFORM "${CMAKE_GENERATOR_PLATFORM}")
  endif()
  string(TOLOWER "${AxTLS_WINDOWS_PLATFORM}" AxTLS_WINDOWS_PLATFORM)
  if(AxTLS_WINDOWS_PLATFORM STREQUAL "win32")
    set(AxTLS_ARCH x86)
  elseif(AxTLS_WINDOWS_PLATFORM STREQUAL "arm64")
    set(AxTLS_ARCH arm64)
  elseif(AxTLS_WINDOWS_PLATFORM STREQUAL "x64" OR CMAKE_SIZEOF_VOID_P EQUAL 8)
    set(AxTLS_ARCH x64)
  else()
    set(AxTLS_ARCH x86)
  endif()
elseif(APPLE)
  set(AxTLS_PLATFORM macos)
  set(AxTLS_ARCH "${CMAKE_OSX_ARCHITECTURES}")
  if(NOT AxTLS_ARCH)
    set(AxTLS_ARCH "${CMAKE_SYSTEM_PROCESSOR}")
  endif()
  list(GET AxTLS_ARCH 0 AxTLS_ARCH)
elseif(UNIX AND CMAKE_SYSTEM_NAME STREQUAL "Linux")
  set(AxTLS_PLATFORM linux)
  set(AxTLS_ARCH "${CMAKE_SYSTEM_PROCESSOR}")
else()
  message(FATAL_ERROR "Unsupported axTLS target ${CMAKE_SYSTEM_NAME}/${CMAKE_SYSTEM_PROCESSOR}")
endif()

if(AxTLS_ARCH STREQUAL "amd64")
  set(AxTLS_ARCH x86_64)
elseif(AxTLS_ARCH STREQUAL "aarch64" AND NOT AxTLS_PLATFORM STREQUAL "linux")
  set(AxTLS_ARCH arm64)
elseif(AxTLS_ARCH STREQUAL "arm64" AND AxTLS_PLATFORM STREQUAL "linux")
  set(AxTLS_ARCH aarch64)
elseif(AxTLS_ARCH STREQUAL "arm" OR AxTLS_ARCH STREQUAL "armv7")
  set(AxTLS_ARCH armv7l)
endif()

set(AXTLS_DIR "${AxTLS_LOCAL_ROOT}/${AxTLS_PLATFORM}/${AxTLS_ARCH}" CACHE PATH "axTLS prebuilt directory" FORCE)
find_path(AXTLS_INCLUDE_DIR NAMES axtls/axtls.h HINTS "${AXTLS_DIR}/include"
  NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
find_library(AXTLS_LIBRARY NAMES axtls libaxtls HINTS "${AXTLS_DIR}/lib"
  NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)

include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(AxTLS REQUIRED_VARS AXTLS_INCLUDE_DIR AXTLS_LIBRARY)
if(AxTLS_FOUND AND NOT TARGET AxTLS::AxTLS)
  add_library(AxTLS::AxTLS STATIC IMPORTED)
  set_target_properties(AxTLS::AxTLS PROPERTIES
    IMPORTED_LOCATION "${AXTLS_LIBRARY}"
    INTERFACE_INCLUDE_DIRECTORIES "${AXTLS_INCLUDE_DIR}"
  )
endif()
